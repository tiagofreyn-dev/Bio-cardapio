# Variáveis de conexão do Supabase para o Bio-cardapio
# IMPORTANTE: Insira as chaves do seu novo banco de dados do Supabase aqui.
# NÃO utilize as chaves do banco de dados do site antigo para evitar gravação cruzada de dados.

VITE_SUPABASE_URL=seu_supabase_url_aqui
VITE_SUPABASE_ANON_KEY=seu_supabase_anon_key_aqui

# Opcional (recomendado): segredo do webhook Cakto/Stripe.
# Com ele definido, POST sem header x-webhook-secret correto = 401 sem DB.
# CAKTO_WEBHOOK_SECRET=gere_um_token_longo_aqui
